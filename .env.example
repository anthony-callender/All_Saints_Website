# Copy to .env (gitignored). Never commit real values.
# The sermon worker reads this file; WordPress reads the same names from the
# web container environment (.ddev/.env) or from constants in wp-config.php.

# --- OpenAI (server-side only) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_SERMON_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- YouTube Data API (upload detection) ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCOouhW9_VVwiVODtl0gDvVA

# --- WordPress REST (dedicated integration user + Application Password) ---
# Local DDEV values are generated by scripts/bootstrap.sh into tmp/local-credentials.env.
WP_BASE_URL=
WP_USERNAME=
WP_APPLICATION_PASSWORD=

# draft (default, an editor reviews) | pending | publish
SERMON_POST_STATUS=draft

# Sermon posts follow the parish format (audio + scripture + YouTube link).
# Optional: free key from https://api.esv.org to include the scripture passage text.
ESV_API_KEY=
# Optional: 1 = also add AI "Sermon Notes" (needs OPENAI_API_KEY). Same as --notes.
SERMON_INCLUDE_NOTES=0

# --- Optional assistant tuning (WordPress) ---
# ASC_CHAT_RATE_LIMIT=15         requests per IP…
# ASC_CHAT_RATE_WINDOW=300       …per this many seconds
# ASC_CHAT_DAILY_CAP=500         site-wide requests per day
# ASC_CHAT_MAX_TOKENS=1200
# ASC_KB_SIMILARITY_THRESHOLD=0.30
